<UserControl x:Class="ST10443277_PROG7312.MeshRouting" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F6F8FB">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Ink" Color="#16283D"/><SolidColorBrush x:Key="Muted" Color="#718096"/><SolidColorBrush x:Key="Line" Color="#E3EAF2"/><SolidColorBrush x:Key="Accent" Color="#0E8F7C"/>
  <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#0E8F7C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#0E8F7C"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E1EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#16283D"/></Style>
  <Style TargetType="ListView"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#16283D"/></Style>
 </UserControl.Resources>
 <Grid Margin="34,28,34,30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="320"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="BackButton" Content="←  Gateway" Style="{StaticResource QuietButton}" Width="112" Height="40" Padding="16,10" HorizontalContentAlignment="Center" Click="Back_Click" VerticalAlignment="Top"/>
   <StackPanel Grid.Column="1" Margin="22,0,0,0"><TextBlock Text="NETWORK OPERATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Mesh topology" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,4,0,3"/><TextBlock Text="See how telemetry moves through the network and investigate the health of every node." Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="270"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="TRACE A DEVICE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="Route to gateway" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><ComboBox x:Name="SensorSelector" Grid.Column="1" SelectionChanged="Sensor_Changed"/><Button Grid.Column="4" Content="Refresh topology" Style="{StaticResource PrimaryButton}" Click="Refresh_Click" Margin="18,0,0,0"/><TextBlock x:Name="SummaryText" Grid.Column="3" Text="Loading network…" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap"/></Grid></Border>
  <Border Grid.Row="2" Background="#10283D" CornerRadius="14" Padding="12" BorderBrush="#24465F" BorderThickness="1"><Grid><Canvas x:Name="NetworkCanvas" Background="#10283D" SizeChanged="Canvas_SizeChanged"><Border Background="#183D55" CornerRadius="14" Padding="10,6" Canvas.Left="14" Canvas.Top="12"><TextBlock Text="PHYSICAL GRAPH  /  MST OVERLAY" Foreground="#B8D5E4" FontSize="10" FontWeight="Bold"/></Border></Canvas><StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#183D55" Orientation="Horizontal" Margin="0,0,14,12"><StackPanel Orientation="Horizontal" Margin="12,8"><Ellipse Width="9" Height="9" Fill="#54D69A" Margin="0,0,6,0"/><TextBlock Text="MST link" Foreground="White" FontSize="11"/></StackPanel><StackPanel Orientation="Horizontal" Margin="12,8"><Ellipse Width="9" Height="9" Fill="#F3C969" Margin="0,0,6,0"/><TextBlock Text="Selected route" Foreground="White" FontSize="11"/></StackPanel></StackPanel></Grid></Border>
  <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.7*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,9,0"><StackPanel><TextBlock Text="ROUTE INSPECTOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock x:Name="RouteText" Text="Select a device to trace its route." FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,6,0,4"/><TextBlock Text="Each hop is shown with its cumulative route cost." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/><ItemsControl x:Name="RouteList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F1F8F6" CornerRadius="6" Padding="10,7" Margin="0,0,0,6"><TextBlock Text="→  {Binding}" Foreground="#0B6F63" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
   <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="9,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="TELEMETRY HISTORY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Selected sensor readings" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="HistoryStatus" DockPanel.Dock="Right" Text="Select a sensor" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" TextWrapping="Wrap" TextAlignment="Right" Width="210"/></DockPanel><Border Grid.Row="1" Background="#F6F8FB" CornerRadius="6" Padding="10,7" Margin="0,14,0,8"><TextBlock Text="AVL TREE RANGE QUERY  •  LAST 24 HOURS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/></Border><ListView Grid.Row="2" x:Name="HistoryList" MinHeight="130"><ListView.View><GridView><GridViewColumn Header="Time" DisplayMemberBinding="{Binding Timestamp}" Width="155"/><GridViewColumn Header="Type" DisplayMemberBinding="{Binding Category}" Width="110"/><GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="85"/><GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="180"/></GridView></ListView.View></ListView></Grid></Border>
  </Grid>
 </Grid>
</UserControl>
