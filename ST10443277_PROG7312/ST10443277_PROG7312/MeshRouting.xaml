<UserControl x:Class="ST10443277_PROG7312.MeshRouting" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F7FA">
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="300"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,18"><Button x:Name="BackButton" DockPanel.Dock="Left" Content="←  Gateway" Padding="16,9" Margin="0,0,18,0" Background="#126B60" Foreground="White" FontWeight="SemiBold" Click="Back_Click"/><StackPanel><TextBlock Text="NETWORK TOPOLOGY" Foreground="#126B60" FontWeight="Bold" FontSize="11"/><TextBlock Text="Mesh routing and node health" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Explore the active mesh, trace a shortest route to the gateway, and inspect telemetry history." Foreground="#576579" Margin="0,5,0,0"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"><DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="TRACE SENSOR" FontWeight="Bold" Foreground="#576579" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="SensorSelector" Width="230" Padding="7" SelectionChanged="Sensor_Changed"/><Button Content="Refresh topology" Click="Refresh_Click" Padding="12,7" Margin="12,0,0,0" Background="#126B60" Foreground="White"/></StackPanel><TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Foreground="#126B60" VerticalAlignment="Center"/></DockPanel></Border>
  <Border Grid.Row="2" Background="#142C40" CornerRadius="8" Padding="10"><Canvas x:Name="NetworkCanvas" Background="#142C40" SizeChanged="Canvas_SizeChanged"><TextBlock Text="Gateway" Foreground="#B7CADA" Canvas.Left="12" Canvas.Top="10"/></Canvas></Border>
  <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="SELECTED ROUTE" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="RouteText" Text="Select a sensor to trace its route." Foreground="#576579" Margin="0,8,0,12"/><ItemsControl x:Name="RouteList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="→  {Binding}" FontSize="14" Margin="0,3" Foreground="#126B60"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Column="1" Background="White" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="TELEMETRY HISTORY" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="HistoryStatus" Text="Select a sensor to view its retained readings." Foreground="#576579" Margin="0,6,0,8"/><ListView x:Name="HistoryList" Height="180"><ListView.View><GridView><GridViewColumn Header="Time" DisplayMemberBinding="{Binding Timestamp}" Width="150"/><GridViewColumn Header="Type" DisplayMemberBinding="{Binding Category}" Width="110"/><GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="90"/><GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="180"/></GridView></ListView.View></ListView></StackPanel></Border></Grid>
 </Grid>
</UserControl>
