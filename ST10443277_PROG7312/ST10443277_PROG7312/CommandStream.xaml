<UserControl x:Class="ST10443277_PROG7312.CommandStream" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F8FB">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Ink" Color="#172B42"/><SolidColorBrush x:Key="Muted" Color="#708196"/><SolidColorBrush x:Key="Line" Color="#E1E9F0"/><SolidColorBrush x:Key="Teal" Color="#0E8F7C"/>
  <Style x:Key="Action" TargetType="Button"><Setter Property="Background" Value="#0E8F7C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="SoftAction" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="#0E8F7C"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,6,12,0"/><Setter Property="BorderBrush" Value="#D7E1EA"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,6,12,0"/><Setter Property="BorderBrush" Value="#D7E1EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Height" Value="39"/></Style>
  <DataTemplate x:Key="DeviceCard"><Border Width="238" Margin="0,0,12,0" Padding="15" Background="White" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="10"><StackPanel><DockPanel><TextBlock Text="{Binding DeviceId}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><Border DockPanel.Dock="Right" Background="#E7F5F1" Padding="7,4" CornerRadius="5"><TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#087262" FontWeight="Bold"/></Border></DockPanel><TextBlock Text="{Binding LocationCategory}" Foreground="{StaticResource Muted}" Margin="0,7,0,12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ValueText}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="{Binding LastSeenText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate>
  <DataTemplate x:Key="InsightRow"><Border Padding="12,9" Margin="0,0,0,6" Background="#FFF9E9" BorderBrush="#F0D78C" BorderThickness="1" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Grid.Column="1" Text="{Binding Explanation}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding ConfidenceText}" Foreground="#087262" HorizontalAlignment="Right"/></Grid></Border></DataTemplate>
 </UserControl.Resources>
 <Grid Margin="34,28,34,30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="BackButton" Content="←  Gateway" Style="{StaticResource SoftAction}" Width="112" Height="40" Padding="16,10" HorizontalContentAlignment="Center" Click="Back_Click" VerticalAlignment="Top"/><StackPanel Grid.Column="1" Margin="22,0,0,0"><TextBlock Text="DEVICE OPERATIONS" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Command center" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,4,0,3"/><TextBlock Text="Send safe device overrides and follow their delivery history." Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TARGET DEVICE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBox x:Name="DeviceInput" ToolTip="Enter a device ID or MAC address"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="COMMAND" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><ComboBox x:Name="CommandInput"><ComboBoxItem Content="Turn on relay / pump" Tag="TurnOn"/><ComboBoxItem Content="Turn off relay / pump" Tag="TurnOff"/><ComboBoxItem Content="Set sampling interval" Tag="SetSamplingInterval"/><ComboBoxItem Content="Restart device" Tag="Restart"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="PARAMETERS (OPTIONAL)" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBox x:Name="ParametersInput" ToolTip="For example: interval=30"/></StackPanel><Button Grid.Column="3" x:Name="SendButton" Content="Send command" Style="{StaticResource Action}" VerticalAlignment="Bottom" Click="Send_Click" Margin="0,0,0,0"/></Grid></Border>
  <DockPanel Grid.Row="2" Margin="0,0,0,14"><TextBlock x:Name="StatusText" Text="API OFFLINE" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="PendingText" Text="0 queued" Foreground="{StaticResource Teal}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="Undo last" Style="{StaticResource SoftAction}" Click="Undo_Click" Margin="0,0,8,0"/><Button Content="Refresh" Style="{StaticResource Action}" Click="Refresh_Click"/></StackPanel></DockPanel>
  <Border Grid.Row="3" Background="#123E46" BorderBrush="#286A69" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="LIVE DEVICE STATE" Foreground="#9DE5D2" FontSize="11" FontWeight="Bold"/><TextBlock Text="Connected devices and their latest readings" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="DeviceCountText" DockPanel.Dock="Right" Text="0 devices" Foreground="#D4F2E5" VerticalAlignment="Center"/></DockPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12"><TextBox x:Name="DeviceFilter" Width="210" TextChanged="Filter_Changed" ToolTip="Search device or location"/><ComboBox x:Name="CategoryFilter" Width="160" SelectionChanged="Filter_Changed"><ComboBoxItem Content="All categories"/><ComboBoxItem Content="Temperature"/><ComboBoxItem Content="Humidity"/><ComboBoxItem Content="Power"/><ComboBoxItem Content="Actuator"/></ComboBox><CheckBox x:Name="AlertsOnly" Content="Active alerts only" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" Foreground="#D4F2E5"/></StackPanel><ListBox Grid.Row="2" x:Name="DeviceList" ItemTemplate="{StaticResource DeviceCard}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></Grid></Border>
  <Border Grid.Row="4" Background="#FFFDF5" BorderBrush="#F0D78C" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="AUTOMATED INSIGHTS" Foreground="#B67A00" FontSize="11" FontWeight="Bold"/><TextBlock Text="Suggested actions from recent device activity" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="PatternSummaryText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><ListBox Grid.Row="1" x:Name="InsightsList" ItemTemplate="{StaticResource InsightRow}" BorderThickness="0" Background="Transparent" Margin="0,12,0,0"/></Grid></Border>
  <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock Text="SORTED TELEMETRY TIMELINE" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Chronological readings indexed by timestamp" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,3,0,4"/><TextBlock x:Name="TimelineStatusText" Text="Loading sorted timeline..." Foreground="{StaticResource Muted}"/><ListView x:Name="TimelineList" Height="145" Margin="0,8,0,0" AutomationProperties.Name="Chronologically sorted telemetry timeline"><ListView.View><GridView><GridViewColumn Header="Timestamp" DisplayMemberBinding="{Binding TimeText}" Width="180"/><GridViewColumn Header="Device" DisplayMemberBinding="{Binding DeviceId}" Width="180"/><GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="130"/><GridViewColumn Header="Value" DisplayMemberBinding="{Binding ValueText}" Width="120"/></GridView></ListView.View></ListView><TextBlock x:Name="UniqueErrorStateText" Foreground="{StaticResource Teal}" Margin="0,6,0,0"/></StackPanel></Border>
  <Border Grid.Row="6" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="COMMAND HISTORY" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Review, acknowledge, or audit recent overrides" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,3,0,10"/><ListView x:Name="HistoryList"><ListView.View><GridView><GridViewColumn Header="Time" DisplayMemberBinding="{Binding CreatedAtDisplay}" Width="155"/><GridViewColumn Header="Device" DisplayMemberBinding="{Binding DeviceId}" Width="160"/><GridViewColumn Header="Command" DisplayMemberBinding="{Binding CommandSummary}" Width="250"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="110"/><GridViewColumn Header="" Width="120"><GridViewColumn.CellTemplate><DataTemplate><Button Content="Acknowledge" Click="Acknowledge_Click" Padding="8,4" IsEnabled="{Binding CanAcknowledge}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView></StackPanel></Border>
 </Grid>
</UserControl>
