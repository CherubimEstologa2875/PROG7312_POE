<UserControl x:Class="ST10443277_PROG7312.CommandStream" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F7FA">
 <UserControl.Resources>
  <Style x:Key="Action" TargetType="Button"><Setter Property="Background" Value="#126B60"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,5,12,0"/></Style>
  <DataTemplate x:Key="DeviceCard"><Border Width="238" Margin="0,0,10,0" Padding="14" Background="#FFFFFF" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="8"><StackPanel><DockPanel><TextBlock Text="{Binding DeviceId}" FontSize="16" FontWeight="SemiBold"/><Border DockPanel.Dock="Right" Background="#E1F3ED" Padding="6,3" CornerRadius="4"><TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#126B60" FontWeight="Bold"/></Border></DockPanel><TextBlock Text="{Binding LocationCategory}" Foreground="#576579" Margin="0,7,0,12"/><TextBlock Text="{Binding ValueText}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding LastSeenText}" Foreground="#576579" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate>
  <DataTemplate x:Key="InsightRow"><Border Padding="10,7" Margin="0,0,0,5" Background="#FFF8E6" BorderBrush="#F0D78C" BorderThickness="1" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Explanation}" Foreground="#576579"/><TextBlock Grid.Column="2" Text="{Binding ConfidenceText}" Foreground="#126B60" HorizontalAlignment="Right"/></Grid></Border></DataTemplate>
 </UserControl.Resources>
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,22"><Button x:Name="BackButton" DockPanel.Dock="Left" Content="←  Gateway" Style="{StaticResource Action}" Click="Back_Click"/><StackPanel><TextBlock Text="REAL-TIME COMMANDS" Foreground="#126B60" FontWeight="Bold" FontSize="11"/><TextBlock Text="Command stream and history" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Live device state, manual overrides and delivery history." Foreground="#576579" Margin="0,5,0,0"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TARGET DEVICE" FontSize="11" FontWeight="Bold" Foreground="#576579"/><TextBox x:Name="DeviceInput"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="MANUAL OVERRIDE" FontSize="11" FontWeight="Bold" Foreground="#576579"/><ComboBox x:Name="CommandInput" Margin="0,5,12,0" Padding="8,6"><ComboBoxItem Content="TurnOn (relay/pump)" Tag="TurnOn"/><ComboBoxItem Content="TurnOff (relay/pump)" Tag="TurnOff"/><ComboBoxItem Content="SetSamplingInterval" Tag="SetSamplingInterval"/><ComboBoxItem Content="Restart" Tag="Restart"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="PARAMETERS (OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="#576579"/><TextBox x:Name="ParametersInput" ToolTip="For example: interval=30"/></StackPanel><Button Grid.Column="3" x:Name="SendButton" Content="Send override" Style="{StaticResource Action}" VerticalAlignment="Bottom" Click="Send_Click"/></Grid></Border>
  <DockPanel Grid.Row="2" Margin="0,0,0,12"><TextBlock x:Name="StatusText" Text="API OFFLINE" Foreground="#576579" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="PendingText" Text="0 queued" Foreground="#126B60" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="Undo last override" Style="{StaticResource Action}" Click="Undo_Click"/><Button Content="Refresh" Style="{StaticResource Action}" Click="Refresh_Click"/></StackPanel></DockPanel>
  <Border Grid.Row="3" Background="#1B4D43" BorderBrush="#2F6B5D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="LIVE DEVICE STATE" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DeviceCountText" DockPanel.Dock="Right" Text="0 devices" Foreground="#C8DED5" VerticalAlignment="Center"/></DockPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10"><TextBox x:Name="DeviceFilter" Width="190" TextChanged="Filter_Changed" ToolTip="Search device or location"/><ComboBox x:Name="CategoryFilter" Width="150" Margin="0,5,12,0" Padding="8,6" SelectionChanged="Filter_Changed"><ComboBoxItem Content="All categories"/><ComboBoxItem Content="Temperature"/><ComboBoxItem Content="Humidity"/><ComboBoxItem Content="Power"/><ComboBoxItem Content="Actuator"/></ComboBox><CheckBox x:Name="AlertsOnly" Content="Active alerts only" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" Foreground="#FFD2C8"/></StackPanel><ListBox Grid.Row="2" x:Name="DeviceList" ItemTemplate="{StaticResource DeviceCard}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></Grid></Border>
  <Border Grid.Row="4" Background="#FFFDF5" BorderBrush="#F0D78C" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="SUGGESTED ACTIONS / AUTOMATED INSIGHTS" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="PatternSummaryText" DockPanel.Dock="Right" Foreground="#576579"/></DockPanel><ListBox Grid.Row="1" x:Name="InsightsList" ItemTemplate="{StaticResource InsightRow}" BorderThickness="0" Background="Transparent" Margin="0,10,0,0"/></Grid></Border>
  <Border Grid.Row="5" Background="White" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="8" Padding="14"><ListView x:Name="HistoryList"><ListView.View><GridView><GridViewColumn Header="Time" DisplayMemberBinding="{Binding CreatedAtDisplay}" Width="150"/><GridViewColumn Header="Device" DisplayMemberBinding="{Binding DeviceId}" Width="160"/><GridViewColumn Header="Command" DisplayMemberBinding="{Binding CommandSummary}" Width="250"/><GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="110"/><GridViewColumn Header="" Width="120"><GridViewColumn.CellTemplate><DataTemplate><Button Content="Acknowledge" Click="Acknowledge_Click" Padding="8,4" IsEnabled="{Binding CanAcknowledge}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView></Border>
 </Grid>
</UserControl>
