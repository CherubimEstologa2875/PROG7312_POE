<Window x:Class="ST10443277_PROG7312.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ST10443277_PROG7312" Title="Smart-X | IoT Gateway" Width="1220" Height="820" MinWidth="700" MinHeight="500" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" Background="#F5F8FB" FontFamily="Segoe UI" Foreground="#172B42" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#172B42"/><SolidColorBrush x:Key="Muted" Color="#708196"/><SolidColorBrush x:Key="Border" Color="#E1E9F0"/><SolidColorBrush x:Key="Teal" Color="#0E8F7C"/><SolidColorBrush x:Key="Navy" Color="#102B44"/>
  <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#0E8F7C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#E7F3F0"/><Setter Property="Foreground" Value="#087262"/></Style>
  <Style x:Key="ModuleCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="ModuleTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,10,0,8"/></Style>
  <Style x:Key="Body" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="21"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <DockPanel>
  <Border x:Name="GatewayHeader" DockPanel.Dock="Top" Background="#102B44" Padding="30,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#29C7A8" CornerRadius="10" Width="42" Height="42" Margin="0,0,13,0"><Grid><Ellipse Width="12" Height="12" Fill="#102B44" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="25" Height="25" Stroke="#102B44" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><StackPanel><TextBlock Text="SMART-X" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="CONNECTED DEVICE OPERATIONS" Foreground="#AFC5D4" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#193C55" CornerRadius="18" Padding="12,7" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#50D69A" Margin="0,0,7,0"/><TextBlock Text="GATEWAY ONLINE" Foreground="#D4F2E5" FontSize="11" FontWeight="Bold"/></StackPanel></Border><TextBlock Text="PROG7312  /  ST10443277" Foreground="#B7CADA" FontSize="11" VerticalAlignment="Center"/></StackPanel>
   </Grid>
  </Border>
  <Border x:Name="GatewayFooter" DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="30,12"><Grid><TextBlock Text="SMART-X  /  IOT MESH ECOSYSTEM" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="Telemetry  •  Commands  •  Mesh routing" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></Grid></Border>
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="True"><Grid x:Name="PageContent" Margin="34,30,34,34" MaxWidth="1220" MinWidth="620" HorizontalAlignment="Stretch">
   <StackPanel x:Name="LandingView">
    <Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GATEWAY OVERVIEW" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Your connected environment" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,7,0,7"/><TextBlock Text="Monitor sensor data, issue device commands, and understand how telemetry moves through your mesh network." Style="{StaticResource Body}" FontSize="15"/></StackPanel><Border Grid.Column="1" Background="#EAF7F3" CornerRadius="14" Padding="22,16" Width="210" VerticalAlignment="Center"><StackPanel><TextBlock Text="SYSTEM STATUS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="All modules ready" Foreground="#087262" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="Choose an operation below" Foreground="#598479" FontSize="11"/></StackPanel></Border></Grid>
    <Border Background="#102B44" CornerRadius="16" Padding="22" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SMART-X CONTROL CENTER" Foreground="#7EDCC7" FontSize="10" FontWeight="Bold"/><TextBlock Text="Operate with confidence" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock Text="Live telemetry and network intelligence in one place." Foreground="#B7CADA" FontSize="12"/></StackPanel><Border Grid.Column="1" BorderBrush="#31526A" BorderThickness="1" CornerRadius="9" Padding="15,9" Margin="22,0,10,0"><StackPanel><TextBlock Text="01" Foreground="#7EDCC7" FontSize="18" FontWeight="Bold"/><TextBlock Text="Telemetry" Foreground="#D8E7EF" FontSize="11"/></StackPanel></Border><Border Grid.Column="2" BorderBrush="#31526A" BorderThickness="1" CornerRadius="9" Padding="15,9" Margin="0,0,10,0"><StackPanel><TextBlock Text="02" Foreground="#7EDCC7" FontSize="18" FontWeight="Bold"/><TextBlock Text="Commands" Foreground="#D8E7EF" FontSize="11"/></StackPanel></Border><Border Grid.Column="3" BorderBrush="#31526A" BorderThickness="1" CornerRadius="9" Padding="15,9"><StackPanel><TextBlock Text="03" Foreground="#7EDCC7" FontSize="18" FontWeight="Bold"/><TextBlock Text="Mesh" Foreground="#D8E7EF" FontSize="11"/></StackPanel></Border></Grid></Border>
    <TextBlock Text="CHOOSE AN OPERATION" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,11"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource ModuleCard}" BorderBrush="#A8DDD2" Background="#FCFFFE"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="01  /  SENSOR TELEMETRY" Foreground="{StaticResource Teal}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Sensor data" Style="{StaticResource ModuleTitle}"/><TextBlock Text="Register devices, ingest readings, and investigate historical telemetry with clear health indicators." Style="{StaticResource Body}"/><Border Background="#E7F5F1" CornerRadius="5" Padding="9,6" HorizontalAlignment="Left" Margin="0,18,0,0"><TextBlock Text="READY  •  DATA INGESTION" Foreground="#087262" FontSize="10" FontWeight="Bold"/></Border></StackPanel><Button x:Name="OpenTelemetryButton" Grid.Row="1" Content="Open telemetry  ›" Style="{StaticResource PrimaryButton}" Click="OpenTelemetry_Click" Margin="0,22,0,0"/></Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource ModuleCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="02  /  DEVICE CONTROL" Foreground="#718096" FontSize="10" FontWeight="Bold"/><TextBlock Text="Command center" Style="{StaticResource ModuleTitle}"/><TextBlock Text="Send real-time commands, review delivery history, and understand device activity at a glance." Style="{StaticResource Body}"/><Border Background="#F1F4F7" CornerRadius="5" Padding="9,6" HorizontalAlignment="Left" Margin="0,18,0,0"><TextBlock Text="READY  •  LIVE CONTROL" Foreground="#53677C" FontSize="10" FontWeight="Bold"/></Border></StackPanel><Button x:Name="CommandStreamButton" Grid.Row="1" Content="Open commands  ›" Style="{StaticResource SecondaryButton}" Click="OpenCommands_Click" Margin="0,22,0,0"/></Grid></Border>
     <Border Grid.Column="4" Style="{StaticResource ModuleCard}" BorderBrush="#B7D5E6"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="03  /  NETWORK INTELLIGENCE" Foreground="#287A9F" FontSize="10" FontWeight="Bold"/><TextBlock Text="Mesh topology" Style="{StaticResource ModuleTitle}"/><TextBlock Text="Visualise graph connections, trace routes by device ID, and inspect the MST power-efficient network paths." Style="{StaticResource Body}"/><Border Background="#EAF4F9" CornerRadius="5" Padding="9,6" HorizontalAlignment="Left" Margin="0,18,0,0"><TextBlock Text="READY  •  ROUTING ANALYTICS" Foreground="#287A9F" FontSize="10" FontWeight="Bold"/></Border></StackPanel><Button x:Name="MeshRoutingButton" Grid.Row="1" Content="Open mesh routing  ›" Style="{StaticResource SecondaryButton}" Click="OpenMesh_Click" Margin="0,22,0,0"/></Grid></Border>
    </Grid>
    <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,24,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#FFF5D9" CornerRadius="8" Width="34" Height="34"><TextBlock Text="i" Foreground="#B67A00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="A simple workflow for every device" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/><TextBlock Text="Start with telemetry, use commands to act, then open mesh routing to understand the path and health of the network." Style="{StaticResource Body}" FontSize="12"/></StackPanel></Grid></Border>
   </StackPanel>
   <local:TelemetryDashboard x:Name="TelemetryView" Visibility="Collapsed" BackRequested="BackToGateway_Click"/>
   <local:CommandStream x:Name="CommandView" Visibility="Collapsed" BackRequested="BackToGateway_Click"/>
   <local:MeshRouting x:Name="MeshView" Visibility="Collapsed" BackRequested="BackToGateway_Click"/>
  </Grid></ScrollViewer>
 </DockPanel>
</Window>
